<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>QuickSIP</RootNamespace>
    <AssemblyName>QuickSIP</AssemblyName>
    <Product>QuickSIP</Product>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationTitle>QuickSIP</ApplicationTitle>
    <Description>Lightweight Windows SIP softphone.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.0.0" />
    <PackageReference Include="SIPSorcery" Version="10.0.16" />
    <PackageReference Include="SIPSorceryMedia.Windows" Version="10.0.16" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\QuickSIP.Core\QuickSIP.Core.csproj" />
  </ItemGroup>
</Project>
